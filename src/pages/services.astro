---
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../config";

const mailBase = `mailto:${siteConfig.social.email}`;
---

<Layout
  title={`Consultation_Services // ${siteConfig.callsign}`}
  description="Consulting services: infrastructure cost audits, architecture reviews, reliability setup, and personal infra, with pricing on request."
>
  <section class="py-8" style={`--accent-color: ${siteConfig.accentColor}`}>
    <div class="panel-header">
      <span class="material-symbols-outlined text-[color:var(--primary)] text-[20px]">handshake</span>
      <h2 class="panel-label">Consultation_Services</h2>
      <a
        href="/"
        class="panel-tag ml-auto hover:text-[color:var(--primary)] transition-colors inline-flex items-center gap-1"
      >
        <span class="material-symbols-outlined text-[14px]">arrow_back</span>
        Back_To_Dashboard
      </a>
    </div>

    <p class="text-sm text-[color:var(--on-surface-variant)] max-w-2xl mb-2">
      You work directly with the person doing the work, not a project manager relaying it to someone else. No bench, no handoffs, no team you've never met billing hours on your account.
    </p>

    <a
      href="/brochure"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 font-mono text-xs uppercase tracking-[0.06em] text-[color:var(--secondary)] hover:text-[color:var(--primary)] transition-colors mb-5"
    >
      <span class="material-symbols-outlined text-[15px]">description</span>
      Download_One_Pager_PDF
    </a>

    <div class="module-seam bg-[color:var(--surface-container)] border-l-4 border-l-[color:var(--primary)] p-4 mb-5 flex flex-col sm:flex-row sm:items-center gap-3 justify-between">
      <div>
        <div class="font-mono text-xs uppercase tracking-[0.06em] text-[color:var(--primary)] mb-1">
          Open_Channel
        </div>
        <p class="text-sm text-[color:var(--on-surface-variant)]">
          20 minutes, no pitch. We figure out if this is worth your time before either of us commits to anything.
        </p>
      </div>
      <a
        href={`${mailBase}?subject=${encodeURIComponent("Intro Call")}`}
        class="flex-shrink-0 py-2 px-4 text-center font-mono text-xs uppercase tracking-[0.08em] bg-[color:var(--primary)] text-white hover:brightness-110 transition-all"
      >
        Open_Channel
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {
        siteConfig.services.map((service) => (
          <div class="service-card module-seam bg-[color:var(--surface-container-lowest)] p-5 flex flex-col transition-transform duration-150">
            <div class="flex items-start justify-between gap-3">
              <span class="font-mono text-xs text-[color:var(--on-surface-variant)]">{service.unit}</span>
              <span class="font-mono text-xs font-bold text-[color:var(--primary)] flex-shrink-0">{service.price}</span>
            </div>
            <h3 class="mt-1 text-lg font-semibold text-[color:var(--on-surface)]">
              {service.name.replace(/_/g, " ")}
            </h3>
            <p class="mt-3 text-sm text-[color:var(--on-surface-variant)] leading-relaxed">{service.pitch}</p>
            <div class="mt-4 bg-[color:var(--surface-container)] border border-[color:var(--outline-variant)] p-2.5">
              <div class="font-mono text-[0.6rem] uppercase tracking-[0.06em] text-[color:var(--secondary)]">
                {service.proofLabel}
              </div>
              <div class="mt-0.5 font-mono text-sm font-bold text-[color:var(--primary)]">{service.proofValue}</div>
            </div>
            <div class="mt-4 flex-1">
              <div class="font-mono text-[0.6rem] uppercase tracking-[0.06em] text-[color:var(--secondary)] mb-2">
                You_Get
              </div>
              <ul class="space-y-1.5">
                {service.deliverables.map((item) => (
                  <li class="flex items-start gap-2 text-sm text-[color:var(--on-surface-variant)]">
                    <span class="text-[color:var(--primary)] font-mono flex-shrink-0">›</span>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
            <a
              href={`${mailBase}?subject=${encodeURIComponent(service.mailSubject)}`}
              class="mt-4 w-full py-2.5 text-center font-mono text-xs uppercase tracking-[0.08em] border border-[color:var(--primary)] text-[color:var(--primary)] hover:bg-[color:var(--primary)] hover:text-white transition-colors"
            >
              {service.cta}
            </a>
          </div>
        ))
      }
    </div>

    <div class="mt-6 module-seam bg-[color:var(--surface-container-lowest)] p-4">
      <div class="flex items-center justify-between mb-3 pb-2 border-b border-[color:var(--outline-variant)]">
        <span class="font-mono text-xs uppercase tracking-[0.06em] text-[color:var(--secondary)]">
          Client_Feedback
        </span>
        <span class="panel-tag">Awaiting_Real_Quotes</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {
          [1, 2].map((n) => (
            <div class="border border-dashed border-[color:var(--outline-variant)] p-4">
              <p class="text-sm text-[color:var(--on-surface-variant)] italic">
                [Placeholder slot {n}: a real client quote goes here once one exists. Not filled in yet, not a real
                testimonial.]
              </p>
              <p class="mt-2 font-mono text-xs text-[color:var(--secondary)]">[Client name, role/company]</p>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-6 module-seam bg-[color:var(--surface-container-lowest)] p-4">
      <div class="font-mono text-xs uppercase tracking-[0.06em] text-[color:var(--secondary)] mb-3 pb-2 border-b border-[color:var(--outline-variant)]">
        Working_With_Me
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-5 gap-4">
        {
          siteConfig.engagement.map((item) => (
            <div class="min-w-0">
              <div class="font-mono text-[0.6rem] uppercase tracking-[0.06em] text-[color:var(--secondary)]">
                {item.label}
              </div>
              <div class="mt-0.5 text-sm text-[color:var(--on-surface)] break-words">{item.value}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .service-card:hover {
    transform: translateY(-2px);
    border-color: var(--primary);
  }
</style>
