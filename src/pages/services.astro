---
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../config";

const mailBase = `mailto:${siteConfig.social.email}`;
---

<Layout
  title={`Consultation_Services // ${siteConfig.callsign}`}
  description="Consulting services: infrastructure cost audits, architecture reviews, reliability setup, and personal infra, with pricing on request."
>
  <section class="py-8" style={`--accent-color: ${siteConfig.accentColor}`}>
    <div class="panel-header">
      <span class="material-symbols-outlined text-[color:var(--primary)] text-[20px]">handshake</span>
      <h2 class="panel-label">Consultation_Services</h2>
      <a
        href="/"
        class="panel-tag ml-auto hover:text-[color:var(--primary)] transition-colors inline-flex items-center gap-1"
      >
        <span class="material-symbols-outlined text-[14px]">arrow_back</span>
        Back_To_Dashboard
      </a>
    </div>

    <p class="text-sm text-[color:var(--on-surface-variant)] max-w-2xl mb-2">
      You work directly with the person doing the work, not a project manager relaying it to someone else. No bench, no handoffs, no team you've never met billing hours on your account.
    </p>

    <div class="mt-5 mb-5">
      <div class="font-mono text-xs uppercase tracking-[0.06em] text-[color:var(--secondary)] mb-3">
        Expertise_Matrix
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {
          siteConfig.expertise.map((row) => (
            <div class="module-seam bg-[color:var(--surface-container-lowest)] p-4 flex flex-col">
              <span class="font-mono text-xs text-[color:var(--on-surface-variant)]">{row.unit}</span>
              <h3 class="mt-1 font-semibold text-[color:var(--on-surface)]">{row.label.replace(/_/g, " ")}</h3>

              <div class="mt-3 font-mono text-[0.6rem] uppercase tracking-[0.06em] text-[color:var(--primary)]">
                Problem
              </div>
              <p class="text-sm text-[color:var(--on-surface-variant)]">{row.problem}</p>

              <div class="mt-3 font-mono text-[0.6rem] uppercase tracking-[0.06em] text-[color:var(--primary)]">
                Approach
              </div>
              <p class="text-sm text-[color:var(--on-surface-variant)]">{row.approach}</p>

              <div class="mt-3 font-mono text-[0.6rem] uppercase tracking-[0.06em] text-[color:var(--primary)]">
                Evidence
              </div>
              <ul class="space-y-1">
                {row.evidence.map((item) => (
                  <li class="flex items-start gap-2 text-sm text-[color:var(--on-surface-variant)]">
                    <span class="text-[color:var(--primary)] font-mono flex-shrink-0">›</span>
                    {item}
                  </li>
                ))}
              </ul>

              <a
                href="#services-list"
                class="mt-4 inline-flex items-center gap-1.5 font-mono text-xs uppercase tracking-[0.08em] text-[color:var(--primary)] hover:underline"
              >
                See_Related_Services
                <span class="material-symbols-outlined text-[15px]">arrow_downward</span>
              </a>
            </div>
          ))
        }
      </div>
    </div>

    <div class="brochure-block module-seam bg-[color:var(--surface-container-lowest)] p-5 mb-5 flex flex-col sm:flex-row items-center gap-5">
      <pre class="brochure-ascii font-mono text-[0.6rem] sm:text-xs leading-[1.15] flex-shrink-0" aria-hidden="true">┌───────────────┐
│ NORD_WINTER   │
│  ───────────  │
│  ▓▓▓▓▓▓▓▓▓    │
│  ▓▓▓▓▓        │
│  ▓▓▓▓▓▓▓▓     │
│  ▓▓▓▓         │
│               │
│          .pdf │
└───────────────┘</pre>
      <div class="flex-1 text-center sm:text-left">
        <div class="font-mono text-xs uppercase tracking-[0.06em] text-[color:var(--primary)] mb-1">
          One_Page_Brief
        </div>
        <p class="text-sm text-[color:var(--on-surface-variant)] mb-3">
          Same content as this page, condensed to one sheet. Take it into a call, forward it, print it.
        </p>
        <a
          href="/brochure"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 py-2 px-4 font-mono text-xs uppercase tracking-[0.08em] border border-[color:var(--primary)] text-[color:var(--primary)] hover:bg-[color:var(--primary)] hover:text-white transition-colors"
        >
          Download_PDF
          <span class="material-symbols-outlined text-[16px]">download</span>
        </a>
      </div>
    </div>

    <div class="module-seam bg-[color:var(--surface-container)] border-l-4 border-l-[color:var(--primary)] p-4 mb-5 flex flex-col sm:flex-row sm:items-center gap-3 justify-between">
      <div>
        <div class="font-mono text-xs uppercase tracking-[0.06em] text-[color:var(--primary)] mb-1">
          Open_Channel
        </div>
        <p class="text-sm text-[color:var(--on-surface-variant)]">
          20 minutes, no pitch. We figure out if this is worth your time before either of us commits to anything.
        </p>
      </div>
      <a
        href={`${mailBase}?subject=${encodeURIComponent("Intro Call")}`}
        class="flex-shrink-0 py-2 px-4 text-center font-mono text-xs uppercase tracking-[0.08em] bg-[color:var(--primary)] text-white hover:brightness-110 transition-all"
      >
        Open_Channel
      </a>
    </div>

    <div id="services-list" class="module-seam bg-[color:var(--surface-container-lowest)] divide-y divide-[color:var(--outline-variant)] scroll-mt-24">
      {
        siteConfig.services.map((service) => (
          <div class="p-5">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <span class="font-mono text-xs text-[color:var(--on-surface-variant)]">{service.unit}</span>
              <span class="font-mono text-xs font-bold text-[color:var(--primary)]">{service.price}</span>
            </div>
            <h3 class="mt-1 text-lg font-semibold text-[color:var(--on-surface)]">
              {service.name.replace(/_/g, " ")}
            </h3>
            <p class="mt-2 text-sm text-[color:var(--on-surface-variant)] leading-relaxed max-w-2xl">
              {service.pitch}
            </p>
            <ul class="mt-3 space-y-1.5">
              {service.deliverables.map((item) => (
                <li class="flex items-start gap-2 text-sm text-[color:var(--on-surface-variant)]">
                  <span class="text-[color:var(--primary)] font-mono flex-shrink-0">›</span>
                  {item}
                </li>
              ))}
            </ul>
            <a
              href={`${mailBase}?subject=${encodeURIComponent(service.mailSubject)}`}
              class="mt-4 inline-flex items-center gap-1.5 font-mono text-xs uppercase tracking-[0.08em] text-[color:var(--primary)] hover:underline"
            >
              {service.cta}
              <span class="material-symbols-outlined text-[15px]">arrow_forward</span>
            </a>
          </div>
        ))
      }
    </div>

    <div class="mt-6 module-seam workshop-promo bg-[color:var(--primary)] text-white p-5 flex flex-col sm:flex-row sm:items-center gap-4 justify-between">
      <div>
        <div class="font-mono text-xs uppercase tracking-[0.08em] flex items-center gap-1.5 mb-1 opacity-90">
          <span class="material-symbols-outlined text-[16px]">campaign</span>
          {siteConfig.workshop.label}
        </div>
        <p class="text-sm opacity-95 max-w-xl">{siteConfig.workshop.pitch}</p>
      </div>
      <a
        href={`${mailBase}?subject=${encodeURIComponent(siteConfig.workshop.mailSubject)}`}
        class="flex-shrink-0 py-2.5 px-5 text-center font-mono text-xs uppercase tracking-[0.08em] bg-white text-[color:var(--primary)] hover:brightness-95 transition-all"
      >
        {siteConfig.workshop.cta}
      </a>
    </div>

    <div class="mt-6 module-seam bg-[color:var(--surface-container-lowest)] p-4">
      <div class="mb-3 pb-2 border-b border-[color:var(--outline-variant)]">
        <span class="font-mono text-xs uppercase tracking-[0.06em] text-[color:var(--secondary)]">
          What_People_Say
        </span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {
          siteConfig.testimonials.map((t) => (
            <div class="border border-[color:var(--outline-variant)] p-4">
              <p class="text-sm text-[color:var(--on-surface-variant)] italic">"{t.quote}"</p>
              <p class="mt-2 font-mono text-xs text-[color:var(--secondary)]">- {t.name}</p>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-6 module-seam bg-[color:var(--surface-container-lowest)] p-4">
      <div class="font-mono text-xs uppercase tracking-[0.06em] text-[color:var(--secondary)] mb-3 pb-2 border-b border-[color:var(--outline-variant)]">
        Working_With_Me
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-5 gap-4">
        {
          siteConfig.engagement.map((item) => (
            <div class="min-w-0">
              <div class="font-mono text-[0.6rem] uppercase tracking-[0.06em] text-[color:var(--secondary)]">
                {item.label}
              </div>
              <div class="mt-0.5 text-sm text-[color:var(--on-surface)] break-words">{item.value}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .service-card:hover {
    transform: translateY(-2px);
    border-color: var(--primary);
  }

  .brochure-block {
    border-style: dashed;
  }

  .brochure-ascii {
    color: var(--primary);
    background: var(--surface-container-low);
    border: 1px solid var(--outline-variant);
    padding: 0.6rem 0.8rem;
    white-space: pre;
  }
</style>
