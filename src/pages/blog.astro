---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { siteConfig } from "../config";

const postsRaw = await getCollection("posts");
const posts = postsRaw
  .map((p) => ({
    slug: p.id,
    date: p.data.date.toISOString().slice(0, 10),
    title: p.data.title,
    tag: p.data.tag,
    status: p.data.status,
  }))
  .sort((a, b) => b.date.localeCompare(a.date));
---

<Layout title={`Dispatch_Log // ${siteConfig.callsign}`} description="Blog: dispatches on platform engineering, infrastructure, and whatever else is worth writing up.">
  <section class="py-8">
    <div class="panel-header">
      <span class="material-symbols-outlined text-[color:var(--primary)] text-[20px]">rss_feed</span>
      <h2 class="panel-label">Dispatch_Log</h2>
      <a
        href="/"
        class="panel-tag ml-auto hover:text-[color:var(--primary)] transition-colors inline-flex items-center gap-1"
      >
        <span class="material-symbols-outlined text-[14px]">arrow_back</span>
        Back_To_Dashboard
      </a>
    </div>

    <div class="module-seam bg-[color:var(--surface-container-lowest)] p-4 flex items-center gap-3 mb-4">
      <span class="font-mono text-sm text-[color:var(--primary)] whitespace-nowrap">
        NW:\LOG&gt;
      </span>
      <input
        id="log-filter"
        type="text"
        placeholder="FILTER_BY_TITLE_OR_TAG..."
        class="flex-1 bg-transparent border-none outline-none font-mono text-sm text-[color:var(--on-surface)] placeholder:text-[color:var(--outline)]"
      />
      <span class="material-symbols-outlined text-[color:var(--outline)] text-[18px]">search</span>
    </div>

    <div class="module-seam bg-[color:var(--surface-container-lowest)] overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-[color:var(--outline-variant)] bg-[color:var(--surface-container-low)]">
            <th class="px-5 py-3 font-mono text-[0.65rem] uppercase tracking-[0.08em] text-[color:var(--primary)]">
              Date
            </th>
            <th class="px-5 py-3 font-mono text-[0.65rem] uppercase tracking-[0.08em] text-[color:var(--primary)]">
              Title
            </th>
            <th class="px-5 py-3 font-mono text-[0.65rem] uppercase tracking-[0.08em] text-[color:var(--primary)]">
              Tag
            </th>
            <th class="px-5 py-3 font-mono text-[0.65rem] uppercase tracking-[0.08em] text-[color:var(--primary)] text-right">
              Status
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[color:var(--outline-variant)]">
          {posts.map((post) => (
            <tr
              class="log-row transition-colors"
              data-title={post.title.toLowerCase()}
              data-tag={post.tag.toLowerCase()}
            >
              <td class="p-0">
                <a href={`/log/${post.slug}`} class="log-cell px-5 py-4 font-mono text-xs text-[color:var(--on-surface-variant)] whitespace-nowrap">
                  {post.date}
                </a>
              </td>
              <td class="p-0">
                <a href={`/log/${post.slug}`} class="log-cell px-5 py-4 text-sm text-[color:var(--on-surface)]">
                  {post.title}
                </a>
              </td>
              <td class="p-0">
                <a href={`/log/${post.slug}`} class="log-cell px-5 py-4 font-mono text-xs text-[color:var(--secondary)]">
                  {post.tag}
                </a>
              </td>
              <td class="p-0">
                <a href={`/log/${post.slug}`} class="log-cell px-5 py-4 font-mono text-xs text-right text-[color:var(--primary)] font-bold justify-end">
                  {post.status}
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      <p id="log-empty" class="hidden px-5 py-6 font-mono text-xs text-[color:var(--secondary)]">
        No entries match that filter.
      </p>
    </div>
  </section>
</Layout>

<script>
  const input = document.getElementById("log-filter") as HTMLInputElement | null;
  const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>(".log-row"));
  const empty = document.getElementById("log-empty");

  input?.addEventListener("input", () => {
    const query = input.value.trim().toLowerCase();
    let visible = 0;
    rows.forEach((row) => {
      const match =
        !query ||
        row.dataset.title?.includes(query) ||
        row.dataset.tag?.includes(query);
      row.style.display = match ? "" : "none";
      if (match) visible++;
    });
    empty?.classList.toggle("hidden", visible !== 0);
  });
</script>

<style>
  .log-row:hover {
    background: color-mix(in srgb, var(--primary) 5%, transparent);
    border-left: 3px solid var(--primary);
  }

  .log-cell {
    display: flex;
    align-items: center;
  }
</style>
