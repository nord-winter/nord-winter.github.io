---
import { siteConfig } from "../config";

const mailBase = `mailto:${siteConfig.social.email}`;

const services = [
  {
    unit: "UNIT-S1 // COST",
    name: "Infrastructure_Cost_Audit",
    pitch:
      "Cut cloud spend 40% by automating VM lifecycle and rightsizing compute on GCP. I find the same waste in your bill and fix it.",
    proofLabel: "Proven_Result",
    proofValue: "40% Reduction",
    cta: "Request_Audit",
    href: `${mailBase}?subject=${encodeURIComponent("Infrastructure Cost Audit")}`,
  },
  {
    unit: "UNIT-S2 // SCALE",
    name: "High_Load_Architecture_Review",
    pitch:
      "Built and operated systems sustaining 80K+ RPS in production. I stress-test your architecture before your users do.",
    proofLabel: "Proven_Result",
    proofValue: "80K+ RPS",
    cta: "Book_Review",
    href: `${mailBase}?subject=${encodeURIComponent("Architecture Review")}`,
  },
  {
    unit: "UNIT-S3 // SRE",
    name: "Platform_Reliability_Setup",
    pitch:
      "Maintained 97% uptime across production services with k6 and Grafana observability. I build the same guardrails for your stack.",
    proofLabel: "Proven_Result",
    proofValue: "97% Uptime",
    cta: "Start_Consultation",
    href: `${mailBase}?subject=${encodeURIComponent("Platform Reliability Consultation")}`,
  },
];

const whoami = [
  {
    id: "client",
    label: "Client",
    line: "> Got infrastructure pain, or need a fresh build. Let's talk specifics.",
    ctaLabel: "Request_Consultation",
    href: `${mailBase}?subject=${encodeURIComponent("Consultation Request")}`,
  },
  {
    id: "employer",
    label: "Employer",
    line: "> Hiring for Platform, Backend or SRE. Full track record below.",
    ctaLabel: "View_Operator_Profile",
    href: `/profile/${siteConfig.slug}`,
  },
  {
    id: "curious",
    label: "Just_Looking",
    line: "> No pressure. Latest posts and drops live in the dispatch log.",
    ctaLabel: "Open_Dispatch",
    href: "/#log",
  },
];
---

<section id="services" class="py-8" style={`--accent-color: ${siteConfig.accentColor}`}>
  <div class="panel-header">
    <span class="material-symbols-outlined text-[color:var(--primary)] text-[20px]">handshake</span>
    <h2 class="panel-label">Consultation_Services</h2>
    <span class="panel-tag ml-auto">3 Offers</span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    {
      services.map((service) => (
        <div class="service-card module-seam bg-[color:var(--surface-container-lowest)] p-5 flex flex-col transition-transform duration-150">
          <span class="font-mono text-xs text-[color:var(--on-surface-variant)]">{service.unit}</span>
          <h3 class="mt-1 text-lg font-semibold text-[color:var(--on-surface)]">
            {service.name.replace(/_/g, " ")}
          </h3>
          <p class="mt-3 text-sm text-[color:var(--on-surface-variant)] leading-relaxed flex-1">
            {service.pitch}
          </p>
          <div class="mt-4 bg-[color:var(--surface-container)] border border-[color:var(--outline-variant)] p-2.5">
            <div class="font-mono text-[0.6rem] uppercase tracking-[0.06em] text-[color:var(--secondary)]">
              {service.proofLabel}
            </div>
            <div class="mt-0.5 font-mono text-sm font-bold text-[color:var(--primary)]">
              {service.proofValue}
            </div>
          </div>
          <a
            href={service.href}
            class="mt-4 w-full py-2.5 text-center font-mono text-xs uppercase tracking-[0.08em] border border-[color:var(--primary)] text-[color:var(--primary)] hover:bg-[color:var(--primary)] hover:text-white transition-colors"
          >
            {service.cta}
          </a>
        </div>
      ))
    }
  </div>

  <div id="whoami-terminal" class="mt-4 terminal-frame bg-[color:var(--surface-container-lowest)] rounded p-5 md:p-6">
    <div class="flex items-center justify-between px-1 mb-2">
      <span class="font-mono text-xs text-[color:var(--secondary)]">CH_03 // Query_Terminal</span>
      <div class="flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-green-500 status-blink" />
        <span class="font-mono text-[0.6rem] text-green-600">Ready</span>
      </div>
    </div>

    <div class="terminal-screen whoami-screen">
      <div class="relative z-[1] px-6 py-6 md:px-10 md:py-8">
        <p class="font-mono text-sm md:text-base">
          <span class="terminal-dim">NW:\QUERY&gt;</span>{" "}
          <span id="whoami-prompt" class="terminal-glow" data-full-text="WHO_ARE_U?"></span
          ><span id="whoami-prompt-cursor" class="terminal-cursor terminal-glow"></span>
        </p>

        <div id="whoami-chips" class="mt-4 flex flex-wrap gap-2 whoami-hidden">
          {
            whoami.map((option, i) => (
              <button type="button" data-whoami={option.id} class="whoami-chip">
                [{i + 1}] {option.label.toUpperCase()}
              </button>
            ))
          }
        </div>

        {
          whoami.map((option) => (
            <div data-whoami-response={option.id} class="whoami-response hidden mt-4">
              <p class="font-mono text-sm">
                <span class="terminal-dim">NW:\QUERY&gt;</span>{" "}
                <span class="whoami-response-text terminal-glow" data-full-text={option.line} />
                <span class="terminal-cursor terminal-glow" />
              </p>
              <a href={option.href} class="terminal-btn mt-4">
                {option.ctaLabel}
                <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  function typeInto(el: HTMLElement, text: string, speed = 28, onDone?: () => void) {
    el.textContent = "";
    let i = 0;
    const step = () => {
      if (i < text.length) {
        el.textContent += text.charAt(i);
        i++;
        setTimeout(step, speed);
      } else {
        onDone?.();
      }
    };
    step();
  }

  const prompt = document.getElementById("whoami-prompt");
  const chipsWrap = document.getElementById("whoami-chips");
  const terminal = document.getElementById("whoami-terminal");

  // Hard fallback: chips must never stay stuck behind pointer-events:none,
  // whatever happens to the observer.
  setTimeout(() => chipsWrap?.classList.remove("whoami-hidden"), 4000);

  if (prompt && terminal) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            typeInto(prompt, prompt.dataset.fullText || "", 45, () => {
              chipsWrap?.classList.remove("whoami-hidden");
            });
            observer.unobserve(terminal);
          }
        });
      },
      { threshold: 0.4 },
    );
    observer.observe(terminal);
  }

  const chips = document.querySelectorAll<HTMLButtonElement>("[data-whoami]");
  const responses = document.querySelectorAll<HTMLElement>("[data-whoami-response]");

  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      const id = chip.dataset.whoami;
      chips.forEach((c) => c.classList.toggle("whoami-chip-active", c === chip));
      responses.forEach((r) => {
        const match = r.dataset.whoamiResponse === id;
        r.classList.toggle("hidden", !match);
        if (match) {
          const textEl = r.querySelector<HTMLElement>(".whoami-response-text");
          if (textEl) typeInto(textEl, textEl.dataset.fullText || "", 18);
        }
      });
    });
  });
</script>

<style>
  .service-card:hover {
    transform: translateY(-2px);
    border-color: var(--primary);
  }

  .whoami-screen {
    min-height: 200px;
    display: flex;
    align-items: center;
  }

  @media (min-width: 768px) {
    .whoami-screen {
      min-height: 240px;
    }
  }

  .whoami-hidden {
    opacity: 0;
    pointer-events: none;
  }

  .whoami-chip {
    padding: 0.4rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    border: 1px solid color-mix(in srgb, var(--glow) 30%, transparent);
    color: var(--glow);
    background: transparent;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  .whoami-chip:hover {
    border-color: var(--glow);
    background: color-mix(in srgb, var(--glow) 10%, transparent);
  }

  .whoami-chip-active {
    border-color: var(--glow);
    background: color-mix(in srgb, var(--glow) 15%, transparent);
  }
</style>
