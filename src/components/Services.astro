---
import { siteConfig } from "../config";

const mailBase = `mailto:${siteConfig.social.email}`;
const contactEmail = siteConfig.social.email;
---

<section id="services" class="py-8" style={`--accent-color: ${siteConfig.accentColor}`}>
  <div class="panel-header">
    <span class="material-symbols-outlined text-[color:var(--primary)] text-[20px]">handshake</span>
    <h2 class="panel-label">Consulting</h2>
    <a
      href="/services"
      class="panel-tag ml-auto hover:text-[color:var(--primary)] transition-colors inline-flex items-center gap-1"
    >
      View_Services
      <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
    </a>
  </div>

  <div class="module-seam bg-[color:var(--surface-container)] border-l-4 border-l-[color:var(--primary)] p-4 flex flex-col sm:flex-row sm:items-center gap-3 justify-between">
    <div>
      <div class="font-mono text-xs uppercase tracking-[0.06em] text-[color:var(--primary)] mb-1">
        Open_Channel
      </div>
      <p class="text-sm text-[color:var(--on-surface-variant)]">
        20 minutes, no pitch. We figure out if this is worth your time before either of us commits to anything.
      </p>
    </div>
    <a
      href={`${mailBase}?subject=${encodeURIComponent("Intro Call")}`}
      class="flex-shrink-0 py-2 px-4 text-center font-mono text-xs uppercase tracking-[0.08em] bg-[color:var(--primary)] text-white hover:brightness-110 transition-all"
    >
      Open_Channel
    </a>
  </div>

  <p class="mt-6 font-mono text-xs uppercase tracking-[0.08em] text-[color:var(--primary)] flex items-center gap-1.5">
    <span class="material-symbols-outlined text-[16px]">bolt</span>
    Fastest_Way_To_Reach_Me
  </p>

  <div id="whoami-terminal" class="mt-2 whoami-highlight terminal-frame bg-[color:var(--surface-container-lowest)] rounded p-5 md:p-6">
    <div class="flex items-center justify-between px-1 mb-2">
      <span class="font-mono text-xs text-[color:var(--secondary)]">CH_03 // Visitor_Interview</span>
      <div class="flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-green-500 status-blink" />
        <span class="font-mono text-[0.6rem] text-green-600">Ready</span>
      </div>
    </div>

    <div class="terminal-screen whoami-screen">
      <div class="relative z-[1] w-full px-6 py-6 md:px-10 md:py-8">
        <p class="terminal-dim font-mono text-[0.65rem] uppercase tracking-[0.08em] mb-3">// Identify_Yourself</p>

        <div id="whoami-log" class="space-y-2"></div>

        <form id="whoami-form" class="mt-2 flex items-center gap-2">
          <span class="terminal-dim font-mono text-sm flex-shrink-0">NW:\QUERY&gt;</span>
          <input
            id="whoami-input"
            type="text"
            autocomplete="off"
            class="whoami-input flex-1 min-w-0 bg-transparent border-none outline-none font-mono text-sm"
          />
          <span class="terminal-cursor terminal-glow flex-shrink-0"></span>
        </form>

        <div id="whoami-cta" class="hidden mt-4">
          <a id="whoami-cta-link" href="#" class="terminal-btn">
            Send_Message
            <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
          </a>
          <button type="button" data-restart class="whoami-restart mt-3 block">
            &lt; Start_Over
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ contactEmail }}>
  function typeInto(el, text, speed, onDone) {
    el.textContent = "";
    let i = 0;
    const step = () => {
      if (i < text.length) {
        el.textContent += text.charAt(i);
        i++;
        setTimeout(step, speed);
      } else if (onDone) {
        onDone();
      }
    };
    step();
  }

  const STEPS = [
    { key: "name", question: () => "WHATS_YOUR_NAME?", maxLength: 60 },
    { key: "need", question: (a) => `${a.name || "Alright"}, WHAT_DO_U_NEED?`, maxLength: 240 },
  ];

  const terminal = document.getElementById("whoami-terminal");
  const log = document.getElementById("whoami-log");
  const form = document.getElementById("whoami-form");
  const input = document.getElementById("whoami-input");
  const ctaWrap = document.getElementById("whoami-cta");
  const ctaLink = document.getElementById("whoami-cta-link");

  let stepIndex = 0;
  let answers = {};
  let started = false;

  function appendPromptLine(text, done) {
    const p = document.createElement("p");
    p.className = "font-mono text-sm";
    const prefix = document.createElement("span");
    prefix.className = "terminal-dim";
    prefix.textContent = "NW:\\QUERY> ";
    const q = document.createElement("span");
    q.className = "terminal-glow";
    p.appendChild(prefix);
    p.appendChild(q);
    log?.appendChild(p);
    typeInto(q, text, 28, done);
  }

  function appendEchoLine(text) {
    const p = document.createElement("p");
    p.className = "font-mono text-sm whoami-echo";
    // Always textContent: this is raw visitor input, never HTML.
    p.textContent = `> ${text}`;
    log?.appendChild(p);
  }

  function askStep(i) {
    const step = STEPS[i];
    if (!step || !input || !form) return;
    input.maxLength = step.maxLength;
    input.value = "";
    form.classList.remove("hidden");
    appendPromptLine(step.question(answers), () => input.focus());
  }

  function finish() {
    form?.classList.add("hidden");
    appendPromptLine(`Got it, ${answers.name || "friend"}. Drafting a message now.`);
    const subject = `Consultation Request from ${answers.name || "a website visitor"}`;
    const body = `Name: ${answers.name || "(not given)"}\nWhat they need: ${answers.need || "(not given)"}`;
    if (ctaLink) {
      ctaLink.href = `mailto:${contactEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    }
    ctaWrap?.classList.remove("hidden");
  }

  function start() {
    if (started) return;
    started = true;
    stepIndex = 0;
    answers = {};
    askStep(0);
  }

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (!input) return;
    const value = input.value.trim();
    if (!value) return;
    appendEchoLine(value);
    answers[STEPS[stepIndex].key] = value;
    stepIndex++;
    if (stepIndex < STEPS.length) {
      setTimeout(() => askStep(stepIndex), 250);
    } else {
      form.classList.add("hidden");
      setTimeout(finish, 250);
    }
  });

  document.querySelectorAll("[data-restart]").forEach((btn) => {
    btn.addEventListener("click", () => {
      if (log) log.textContent = "";
      ctaWrap?.classList.add("hidden");
      started = false;
      start();
    });
  });

  // Hard fallback: never leave the visitor staring at a silent box,
  // whatever happens to the observer.
  setTimeout(start, 3000);

  if (terminal) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            start();
            observer.unobserve(terminal);
          }
        });
      },
      { threshold: 0.4 },
    );
    observer.observe(terminal);
  }
</script>

<style>
  .whoami-highlight {
    box-shadow:
      3px 3px 0px 0px var(--primary),
      0 0 0 1px color-mix(in srgb, var(--primary) 30%, transparent);
  }

  .whoami-screen {
    min-height: 200px;
    display: flex;
    align-items: center;
  }

  @media (min-width: 768px) {
    .whoami-screen {
      min-height: 240px;
    }
  }

  .whoami-input {
    color: var(--glow);
    text-shadow: 0 0 6px color-mix(in srgb, var(--glow) 70%, transparent);
    caret-color: var(--glow);
  }

  .whoami-echo {
    color: color-mix(in srgb, var(--glow) 55%, white 20%);
    padding-left: 1.4rem;
  }

  .whoami-restart {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: color-mix(in srgb, var(--glow) 55%, transparent);
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
  }

  .whoami-restart:hover {
    color: var(--glow);
    text-decoration: underline;
  }
</style>
