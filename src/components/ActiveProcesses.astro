---
import { siteConfig } from "../config";

const dotColors = ["bg-green-500", "bg-blue-500", "bg-amber-500", "bg-[color:var(--primary)]"];

function asciiBar(pct: number) {
  const total = 20;
  const filled = Math.round((pct / 100) * total);
  return "[" + "|".repeat(filled) + "-".repeat(total - filled) + `] ${pct}%`;
}

const skillRows = siteConfig.skills.map((skill, index) => ({
  skill,
  pct: Math.min(97, 65 + ((index * 11) % 33)),
  dot: dotColors[index % dotColors.length],
}));
---

<div class="md:col-span-5 module-seam bg-[color:var(--surface-container-low)] p-6 lg:p-8 space-y-4">
  <div class="panel-header">
    <span class="material-symbols-outlined text-[color:var(--primary)] text-[20px]">analytics</span>
    <h2 class="panel-label">Active_Processes</h2>
  </div>

  <div class="space-y-1">
    {
      skillRows.map((row) => (
        <div class="group hover:bg-[color:var(--surface-container-lowest)] p-3 border border-transparent hover:module-seam transition-all">
          <div class="flex justify-between items-center mb-1">
            <span class="font-mono text-sm text-[color:var(--on-surface)]">{row.skill}</span>
            <span class={`w-2 h-2 rounded-full ${row.dot} status-blink`} />
          </div>
          <div class="font-mono text-xs text-[color:var(--secondary)]">{asciiBar(row.pct)}</div>
        </div>
      ))
    }
  </div>
</div>
