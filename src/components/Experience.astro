---
import { siteConfig } from "../config";
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
---

{
  hasExperience && (
    <section
      id="experience"
      class="py-8"
      style={`--accent-color: ${siteConfig.accentColor}`}
    >
      <div class="panel-header">
        <span class="material-symbols-outlined text-[color:var(--primary)] text-[20px]">terminal</span>
        <h2 class="panel-label">Mission_Logs</h2>
        <span class="panel-tag ml-auto">{siteConfig.experience.length} Entries</span>
      </div>

      <div>
        {siteConfig.experience.map((exp, index) => (
          <div class="flex gap-5">
            <div class="flex flex-col items-center">
              <span class="w-3 h-3 rounded-full glow-dot flex-shrink-0 mt-2" />
              {index < siteConfig.experience.length - 1 && (
                <span class="w-[2px] flex-1 glow-line my-1" />
              )}
            </div>

            <div class="pb-6 flex-1 min-w-0">
              <div class="module-seam bg-white p-5">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-4 gap-1">
                  <div>
                    <h3 class="text-base font-semibold text-[color:var(--on-surface)]">
                      {exp.title}
                    </h3>
                    <p class="font-mono text-sm text-[color:var(--primary)]">{exp.company}</p>
                    {exp.location && (
                      <p class="font-mono text-[0.7rem] text-[color:var(--secondary)]">{exp.location}</p>
                    )}
                  </div>
                  <span class="font-mono text-xs text-[color:var(--on-surface-variant)]">
                    {exp.dateRange}
                  </span>
                </div>

                <ul class="space-y-2">
                  {exp.bullets.map((bullet) => (
                    <li class="flex items-start">
                      <span class="inline-block w-1.5 h-1.5 rounded-full bg-[color:var(--primary)] mt-2 mr-3 flex-shrink-0" />
                      <span class="text-sm text-[color:var(--on-surface-variant)]">{bullet}</span>
                    </li>
                  ))}
                </ul>

                {exp.tech && exp.tech.length > 0 && (
                  <div class="mt-4 pt-3 border-t border-[color:var(--outline-variant)] flex flex-wrap gap-1.5">
                    {exp.tech.map((tech) => (
                      <span class="chip !text-[0.65rem] !py-0.5 !px-1.5">{tech}</span>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  )
}
