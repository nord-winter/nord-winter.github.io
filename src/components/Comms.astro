---
import { siteConfig } from "../config";

const ref = "?ref=portfolio";

const channels = [
  siteConfig.social.telegramChannel && {
    id: "01",
    label: "Telegram_Channel",
    value: siteConfig.social.telegramChannel.replace("https://", ""),
    href: `${siteConfig.social.telegramChannel}${ref}`,
    icon: "campaign",
  },
  siteConfig.social.telegramPersonal && {
    id: "02",
    label: "Telegram_Direct",
    value: siteConfig.social.telegramPersonal.replace("https://", ""),
    href: `${siteConfig.social.telegramPersonal}${ref}`,
    icon: "chat",
  },
  siteConfig.social.discord && {
    id: "03",
    label: "Discord_Server",
    value: siteConfig.social.discord.replace("https://", ""),
    href: `${siteConfig.social.discord}${ref}`,
    icon: "forum",
  },
  siteConfig.social.email && {
    id: "04",
    label: "Direct_Email",
    value: siteConfig.social.email,
    href: `mailto:${siteConfig.social.email}`,
    icon: "mail",
  },
].filter(Boolean) as { id: string; label: string; value: string; href: string; icon: string }[];

const hasChannels = channels.length > 0;

const destinations: Record<string, string | undefined> = {
  consulting: "/services",
  telegramPersonal: siteConfig.social.telegramPersonal && `${siteConfig.social.telegramPersonal}${ref}`,
  telegramChannel: siteConfig.social.telegramChannel && `${siteConfig.social.telegramChannel}${ref}`,
  email: siteConfig.social.email && `mailto:${siteConfig.social.email}`,
  workshop: "/services#workshop",
};

const scenarios = siteConfig.commsScenarios
  .map((s) => ({ ...s, href: destinations[s.channel] }))
  .filter((s) => Boolean(s.href)) as { prompt: string; description: string; channel: string; href: string }[];
---

{
  hasChannels && (
    <section
      id="comms"
      class="py-8"
      style={`--accent-color: ${siteConfig.accentColor}`}
    >
      <div class="panel-header">
        <span class="material-symbols-outlined text-[color:var(--primary)] text-[20px]">podcasts</span>
        <h2 class="panel-label">Comms_Link</h2>
        <span class="panel-tag ml-auto">{channels.length} Channels</span>
      </div>

      <div class="terminal-frame bg-[color:var(--surface-container-lowest)] rounded p-5 md:p-6">
        <div class="flex items-center justify-between px-1 mb-2">
          <span class="font-mono text-xs text-[color:var(--secondary)]">CH_02 // Select_Channel</span>
          <div class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-green-500 status-blink" />
            <span class="font-mono text-[0.6rem] text-green-600">Linked</span>
          </div>
        </div>

        <div class="terminal-screen comms-screen">
          <div class="relative z-[1] w-full flex flex-col justify-center gap-1 px-6 py-6 md:px-10">
            <p class="terminal-glow font-mono text-xs uppercase tracking-[0.06em] mb-3">&gt; What_Do_You_Need</p>
            {scenarios.map((s) => (
              <a
                href={s.href}
                target={s.href.startsWith("/") ? undefined : "_blank"}
                rel={s.href.startsWith("/") ? undefined : "noopener noreferrer"}
                class="comms-row"
              >
                <span class="comms-label">{s.prompt.replace(/_/g, " ")}</span>
                <span class="comms-value">{s.description}</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <details class="mt-3 module-seam bg-[color:var(--surface-container-lowest)] p-4">
        <summary class="font-mono text-xs uppercase tracking-[0.06em] text-[color:var(--secondary)] cursor-pointer">
          Or_Pick_A_Channel_Directly ({channels.length})
        </summary>
        <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-2">
          {channels.map((channel) => (
            <a
              href={channel.href}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3 p-3 border border-[color:var(--outline-variant)] hover:border-[color:var(--primary)] transition-colors"
            >
              <span class="material-symbols-outlined text-[color:var(--primary)] text-[18px]">{channel.icon}</span>
              <span class="min-w-0">
                <span class="block font-mono text-xs uppercase tracking-[0.05em] text-[color:var(--on-surface)]">
                  {channel.label}
                </span>
                <span class="block text-xs text-[color:var(--on-surface-variant)] truncate">{channel.value}</span>
              </span>
            </a>
          ))}
        </div>
      </details>
    </section>
  )
}

<style>
  .comms-screen {
    min-height: 220px;
    display: flex;
    align-items: center;
  }

  @media (min-width: 768px) {
    .comms-screen {
      min-height: 260px;
    }
  }

  .comms-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    padding: 0.4rem 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: color-mix(in srgb, var(--glow) 80%, white 10%);
    text-shadow: 0 0 4px color-mix(in srgb, var(--glow) 55%, transparent);
    transition:
      transform 0.1s ease,
      text-shadow 0.15s ease;
  }

  .comms-row:hover {
    transform: translateX(4px);
    text-shadow:
      0 0 6px color-mix(in srgb, var(--glow) 90%, transparent),
      0 0 14px color-mix(in srgb, var(--glow) 50%, transparent);
  }

  .comms-label {
    text-transform: uppercase;
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }

  .comms-value {
    opacity: 0.6;
    font-size: 0.72rem;
  }

</style>
