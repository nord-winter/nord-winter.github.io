---
import { siteConfig } from "../config";
---

<section
  id="hero"
  class="module-seam bg-[color:var(--surface-container-lowest)] relative overflow-hidden p-6 lg:p-8"
>
  <div id="hero-split-bar" class="absolute top-0 left-0 w-full h-2 flex overflow-hidden">
    <span class="hero-split-a hero-split-diag flex-1 h-full"></span>
    <span class="hero-split-b flex-1 h-full"></span>
  </div>

  <div class="relative z-10 flex flex-col gap-6">
    <div class="flex items-center justify-between border-b border-[color:var(--outline-variant)] pb-4 flex-wrap gap-3">
      <div class="flex items-center gap-2 flex-wrap">
        <span class="font-mono text-xs bg-[color:var(--primary)] text-white px-2 py-0.5">
          SYS_ID: NORD_WINTER_OS_v1.0
        </span>
        <span class="font-mono text-xs border border-[color:var(--outline)] px-2 py-0.5 text-[color:var(--on-surface-variant)]">
          AUTH: AUTHORIZED
        </span>
      </div>
      <div class="flex gap-3 flex-wrap">
        <div class="flex items-center gap-2 bg-green-50 px-3 py-1 rounded-full border border-green-200">
          <span class="w-2 h-2 rounded-full bg-green-500 status-blink"></span>
          <span class="font-mono text-xs text-green-700 pulse-badge">SYSTEM_READY</span>
        </div>
        <div class="flex items-center gap-2 bg-blue-50 px-3 py-1 rounded-full border border-blue-200">
          <span class="w-2 h-2 rounded-full bg-blue-500 status-blink"></span>
          <span class="font-mono text-xs text-blue-700 pulse-badge">LINK_STABLE</span>
        </div>
      </div>
    </div>

    <div class="py-8 md:py-12">
      <a
        href={`/profile/${siteConfig.slug}`}
        class="operator-link inline-flex items-center gap-2 font-mono text-lg md:text-2xl font-medium tracking-tight text-[color:var(--on-surface-variant)] hover:text-[color:var(--primary)] transition-colors"
      >
        <span class="material-symbols-outlined text-[20px] md:text-[24px]">badge</span>
        Access_Operator_Profile
        <span class="material-symbols-outlined text-[18px] operator-link-arrow">arrow_forward</span>
      </a>
      <h1
        id="hero-title"
        class="mt-3 md:mt-4 font-mono text-3xl md:text-5xl font-bold uppercase tracking-tight text-[color:var(--primary)] max-w-2xl terminal-cursor"
        data-full-text="// MISSION_CONTROL"
      >
        // MISSION_CONTROL
      </h1>
      <p class="mt-6 font-mono text-xs uppercase tracking-[0.08em] text-[color:var(--primary)]">
        &gt; Dual_Protocol
      </p>
      <p class="mt-2 text-base md:text-lg text-[color:var(--on-surface-variant)] max-w-xl">
        <span class="hero-word-blue font-semibold">Blue</span> builds it,
        <span class="hero-word-red font-semibold">red</span> tries to break it. Same person, same standards, either color.
      </p>
    </div>
  </div>

  <div class="absolute top-0 right-0 p-8 opacity-[0.04] select-none pointer-events-none">
    <span
      class="material-symbols-outlined"
      style="font-size: 200px; font-variation-settings: 'FILL' 1;"
    >
      rocket_launch
    </span>
  </div>
</section>

<script>
  const heading = document.getElementById("hero-title");
  if (heading) {
    const fullText = heading.dataset.fullText || heading.textContent || "";
    heading.textContent = "";
    let i = 0;
    const type = () => {
      if (i < fullText.length) {
        heading.textContent += fullText.charAt(i);
        i++;
        setTimeout(type, 35);
      }
    };
    type();
  }

  const splitBar = document.getElementById("hero-split-bar");
  document.addEventListener("nw:theme-change", () => {
    if (!splitBar) return;
    splitBar.classList.add("hero-split-glitch");
    setTimeout(() => splitBar.classList.remove("hero-split-glitch"), 420);
  });
</script>

<style>
  .operator-link-arrow {
    transition: transform 0.15s ease;
  }

  .operator-link:hover .operator-link-arrow {
    transform: translateX(3px);
  }

  .hero-split-a {
    background-color: var(--hero-split-a);
    transition: background-color 0.4s ease;
  }

  .hero-split-b {
    background-color: var(--hero-split-b);
    transition: background-color 0.4s ease;
  }

  .hero-split-diag {
    clip-path: polygon(0 0, 100% 0, calc(100% - 10px) 100%, 0 100%);
    margin-right: -10px;
  }

  /* Fixed, never swap with the theme toggle: the word "Blue" is always
     blue and the word "red" is always red, only the bar's left/right
     positions invert. */
  .hero-word-blue {
    color: #00529b;
  }

  .hero-word-red {
    color: #e0393f;
  }

  .hero-split-glitch {
    animation: hero-glitch 0.42s steps(2, end);
  }

  @keyframes hero-glitch {
    0% {
      transform: translateX(0);
      filter: none;
    }
    15% {
      transform: translateX(-4px);
      filter: brightness(1.6) saturate(1.5);
    }
    30% {
      transform: translateX(3px);
    }
    45% {
      transform: translateX(-2px);
      opacity: 0.6;
    }
    60% {
      transform: translateX(2px);
      opacity: 1;
    }
    100% {
      transform: translateX(0);
      filter: none;
    }
  }
</style>
