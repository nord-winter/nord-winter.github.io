---
import { siteConfig } from "../config";
const contactEmail = siteConfig.social.email;
---

<section
  id="hero"
  class="module-seam bg-[color:var(--surface-container-lowest)] relative overflow-hidden p-4 sm:p-6 lg:p-8"
>
  <div id="hero-split-bg" class="hero-split-bg absolute inset-0 z-0"></div>

  <div class="relative z-10 flex flex-col gap-4 sm:gap-6">
    <div class="flex items-center justify-between border-b border-[color:var(--outline-variant)] pb-3 sm:pb-4 flex-wrap gap-3">
      <div class="flex items-center gap-2 flex-wrap">
        <span class="font-mono text-xs bg-[color:var(--primary)] text-white px-2 py-0.5">
          SYS_ID: NORD_WINTER_OS_v1.0
        </span>
        <span class="font-mono text-xs border border-[color:var(--outline)] px-2 py-0.5 text-[color:var(--on-surface-variant)]">
          AUTH: AUTHORIZED
        </span>
      </div>
      <div class="flex gap-3 flex-wrap">
        <div class="flex items-center gap-2 bg-green-50 px-3 py-1 rounded-full border border-green-200">
          <span class="w-2 h-2 rounded-full bg-green-500 status-blink"></span>
          <span class="font-mono text-xs text-green-700 pulse-badge">SYSTEM_READY</span>
        </div>
        <div class="flex items-center gap-2 bg-blue-50 px-3 py-1 rounded-full border border-blue-200">
          <span class="w-2 h-2 rounded-full bg-blue-500 status-blink"></span>
          <span class="font-mono text-xs text-blue-700 pulse-badge">LINK_STABLE</span>
        </div>
      </div>
    </div>

    <div class="py-4 sm:py-8 md:py-12">
      <a
        href={`/profile/${siteConfig.slug}`}
        class="operator-link inline-flex items-center gap-2 font-mono text-sm sm:text-lg md:text-2xl font-medium tracking-tight text-[color:var(--on-surface-variant)] hover:text-[color:var(--primary)] transition-colors"
      >
        <span class="material-symbols-outlined text-[18px] sm:text-[20px] md:text-[24px]">badge</span>
        Access_Operator_Profile
        <span class="material-symbols-outlined text-[18px] operator-link-arrow">arrow_forward</span>
      </a>
      <h1
        id="hero-title"
        class="mt-2 sm:mt-3 md:mt-4 font-mono text-2xl sm:text-3xl md:text-5xl font-bold uppercase tracking-tight text-[color:var(--primary)] max-w-2xl terminal-cursor"
        data-full-text="// MISSION_CONTROL"
      >
        // MISSION_CONTROL
      </h1>
      <p class="mt-3 sm:mt-6 font-mono text-[0.65rem] sm:text-xs uppercase tracking-[0.08em] text-[color:var(--primary)]">
        &gt; Dual_Protocol
      </p>
      <p class="mt-2 text-sm sm:text-base md:text-lg text-[color:var(--on-surface-variant)] max-w-xl">
        <span class="hero-word-blue font-semibold">Blue</span> builds it,
        <span class="hero-word-red font-semibold">red</span> tries to break it. Same person, same standards, either color.
      </p>
    </div>

    <div>
      <div class="flex items-center justify-between flex-wrap gap-2">
        <p class="font-mono text-xs uppercase tracking-[0.08em] text-[color:var(--primary)] flex items-center gap-1.5">
          <span class="material-symbols-outlined text-[16px]">bolt</span>
          Fastest_Way_To_Reach_Me
        </p>
        <span class="font-mono text-[0.6rem] uppercase tracking-[0.06em] text-[color:var(--secondary)] flex items-center gap-1.5">
          CH_03 // Visitor_Interview
          <span class="w-1.5 h-1.5 rounded-full bg-green-500 status-blink" />
        </span>
      </div>

      <div id="whoami-terminal" class="mt-2">
        <div class="terminal-screen whoami-screen">
          <div class="relative z-[1] w-full px-4 py-4 sm:px-6 sm:py-6 md:px-10 md:py-8">
            <p class="terminal-dim font-mono text-[0.65rem] uppercase tracking-[0.08em] mb-3">// Identify_Yourself</p>

            <div id="whoami-log" class="space-y-2"></div>

            <form id="whoami-form" class="mt-2 flex items-center gap-2">
              <span class="terminal-dim font-mono text-sm flex-shrink-0">NW:\QUERY&gt;</span>
              <input
                id="whoami-input"
                type="text"
                autocomplete="off"
                class="whoami-input flex-1 min-w-0 bg-transparent border-none outline-none font-mono text-sm"
              />
              <span class="terminal-cursor terminal-glow flex-shrink-0"></span>
            </form>

            <div id="whoami-cta" class="hidden mt-4">
              <a id="whoami-cta-link" href="#" class="terminal-btn">
                Send_Message
                <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
              </a>
              <button type="button" data-restart class="whoami-restart mt-3 block">
                &lt; Start_Over
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="absolute top-0 right-0 p-8 opacity-[0.04] select-none pointer-events-none">
    <span
      class="material-symbols-outlined"
      style="font-size: 200px; font-variation-settings: 'FILL' 1;"
    >
      rocket_launch
    </span>
  </div>
</section>

<script>
  const heading = document.getElementById("hero-title");
  if (heading) {
    const fullText = heading.dataset.fullText || heading.textContent || "";
    heading.textContent = "";
    let i = 0;
    const type = () => {
      if (i < fullText.length) {
        heading.textContent += fullText.charAt(i);
        i++;
        setTimeout(type, 35);
      }
    };
    type();
  }

  const splitBg = document.getElementById("hero-split-bg");
  document.addEventListener("nw:theme-change", () => {
    if (!splitBg) return;
    splitBg.classList.add("hero-split-glitch");
    setTimeout(() => splitBg.classList.remove("hero-split-glitch"), 420);
  });
</script>

<script define:vars={{ contactEmail }}>
  function typeInto(el, text, speed, onDone) {
    el.textContent = "";
    let i = 0;
    const step = () => {
      if (i < text.length) {
        el.textContent += text.charAt(i);
        i++;
        setTimeout(step, speed);
      } else if (onDone) {
        onDone();
      }
    };
    step();
  }

  const STEPS = [
    { key: "name", question: () => "WHATS_YOUR_NAME?", maxLength: 60 },
    { key: "need", question: (a) => `${a.name || "Alright"}, WHAT_DO_U_NEED?`, maxLength: 240 },
  ];

  const terminal = document.getElementById("whoami-terminal");
  const log = document.getElementById("whoami-log");
  const form = document.getElementById("whoami-form");
  const input = document.getElementById("whoami-input");
  const ctaWrap = document.getElementById("whoami-cta");
  const ctaLink = document.getElementById("whoami-cta-link");

  let stepIndex = 0;
  let answers = {};
  let started = false;

  function appendPromptLine(text, done) {
    const p = document.createElement("p");
    p.className = "font-mono text-sm";
    const prefix = document.createElement("span");
    prefix.className = "terminal-dim";
    prefix.textContent = "NW:\\QUERY> ";
    const q = document.createElement("span");
    q.className = "terminal-glow";
    p.appendChild(prefix);
    p.appendChild(q);
    log?.appendChild(p);
    typeInto(q, text, 28, done);
  }

  function appendEchoLine(text) {
    const p = document.createElement("p");
    p.className = "font-mono text-sm whoami-echo";
    // Always textContent: this is raw visitor input, never HTML.
    p.textContent = `> ${text}`;
    log?.appendChild(p);
  }

  function askStep(i) {
    const step = STEPS[i];
    if (!step || !input || !form) return;
    input.maxLength = step.maxLength;
    input.value = "";
    form.classList.remove("hidden");
    appendPromptLine(step.question(answers), () => input.focus());
  }

  function finish() {
    form?.classList.add("hidden");
    appendPromptLine(`Got it, ${answers.name || "friend"}. Drafting a message now.`);
    const subject = `Consultation Request from ${answers.name || "a website visitor"}`;
    const body = `Name: ${answers.name || "(not given)"}\nWhat they need: ${answers.need || "(not given)"}`;
    if (ctaLink) {
      ctaLink.href = `mailto:${contactEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    }
    ctaWrap?.classList.remove("hidden");
  }

  function start() {
    if (started) return;
    started = true;
    stepIndex = 0;
    answers = {};
    askStep(0);
  }

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (!input) return;
    const value = input.value.trim();
    if (!value) return;
    appendEchoLine(value);
    answers[STEPS[stepIndex].key] = value;
    stepIndex++;
    if (stepIndex < STEPS.length) {
      setTimeout(() => askStep(stepIndex), 250);
    } else {
      form.classList.add("hidden");
      setTimeout(finish, 250);
    }
  });

  document.querySelectorAll("[data-restart]").forEach((btn) => {
    btn.addEventListener("click", () => {
      if (log) log.textContent = "";
      ctaWrap?.classList.add("hidden");
      started = false;
      start();
    });
  });

  // Hard fallback: never leave the visitor staring at a silent box,
  // whatever happens to the observer.
  setTimeout(start, 3000);

  if (terminal) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            start();
            observer.unobserve(terminal);
          }
        });
      },
      { threshold: 0.4 },
    );
    observer.observe(terminal);
  }
</script>

<style>
  .operator-link-arrow {
    transition: transform 0.15s ease;
  }

  .operator-link:hover .operator-link-arrow {
    transform: translateX(3px);
  }

  .hero-split-bg {
    background: linear-gradient(
      115deg,
      color-mix(in srgb, var(--hero-split-a) 10%, transparent) 0%,
      color-mix(in srgb, var(--hero-split-a) 10%, transparent) 48%,
      color-mix(in srgb, var(--hero-split-b) 10%, transparent) 52%,
      color-mix(in srgb, var(--hero-split-b) 10%, transparent) 100%
    );
    transition: background 0.4s ease;
  }

  /* Fixed, never swap with the theme toggle: the word "Blue" is always
     blue and the word "red" is always red, only the bar's left/right
     positions invert. */
  .hero-word-blue {
    color: #00529b;
  }

  .hero-word-red {
    color: #e0393f;
  }

  .hero-split-glitch {
    animation: hero-glitch 0.42s steps(2, end);
  }

  @keyframes hero-glitch {
    0% {
      transform: translateX(0);
      filter: none;
    }
    15% {
      transform: translateX(-4px);
      filter: brightness(1.6) saturate(1.5);
    }
    30% {
      transform: translateX(3px);
    }
    45% {
      transform: translateX(-2px);
      opacity: 0.6;
    }
    60% {
      transform: translateX(2px);
      opacity: 1;
    }
    100% {
      transform: translateX(0);
      filter: none;
    }
  }

  .whoami-screen {
    min-height: 170px;
    display: flex;
    align-items: center;
  }

  @media (min-width: 768px) {
    .whoami-screen {
      min-height: 240px;
    }
  }

  .whoami-input {
    color: var(--glow);
    text-shadow: 0 0 6px color-mix(in srgb, var(--glow) 70%, transparent);
    caret-color: var(--glow);
  }

  .whoami-echo {
    color: color-mix(in srgb, var(--glow) 55%, white 20%);
    padding-left: 1.4rem;
  }

  .whoami-restart {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: color-mix(in srgb, var(--glow) 55%, transparent);
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
  }

  .whoami-restart:hover {
    color: var(--glow);
    text-decoration: underline;
  }
</style>
