---
import { siteConfig } from "../config";

const nameUpper = siteConfig.name.toUpperCase();
---

<section
  id="hero"
  class="module-seam bg-white relative overflow-hidden p-6 lg:p-8"
  style={`--accent-color: ${siteConfig.accentColor}`}
>
  <div class="absolute top-0 left-0 w-full h-1 bg-[color:var(--primary)]"></div>

  <div class="relative z-10 flex flex-col gap-6">
    <div class="flex items-center justify-between border-b border-[color:var(--outline-variant)] pb-4 flex-wrap gap-3">
      <div class="flex items-center gap-2 flex-wrap">
        <span class="font-mono text-xs bg-[color:var(--primary)] text-white px-2 py-0.5">
          SYS_ID: PORTFOLIO_OS_v1.0
        </span>
        <span class="font-mono text-xs border border-[color:var(--outline)] px-2 py-0.5 text-[color:var(--on-surface-variant)]">
          AUTH: AUTHORIZED
        </span>
      </div>
      <div class="flex gap-3 flex-wrap">
        <div class="flex items-center gap-2 bg-green-50 px-3 py-1 rounded-full border border-green-200">
          <span class="w-2 h-2 rounded-full bg-green-500 status-blink"></span>
          <span class="font-mono text-xs text-green-700 pulse-badge">SYSTEM_READY</span>
        </div>
        <div class="flex items-center gap-2 bg-blue-50 px-3 py-1 rounded-full border border-blue-200">
          <span class="w-2 h-2 rounded-full bg-blue-500 status-blink"></span>
          <span class="font-mono text-xs text-blue-700 pulse-badge">LINK_STABLE</span>
        </div>
      </div>
    </div>

    <div class="py-8 md:py-12">
      <div class="font-mono text-lg md:text-2xl font-medium tracking-tight text-[color:var(--on-surface-variant)]">
        {nameUpper}
      </div>
      <h1
        id="hero-title"
        class="mt-3 md:mt-4 font-mono text-3xl md:text-5xl font-bold uppercase tracking-tight text-[color:var(--primary)] max-w-2xl terminal-cursor"
        data-full-text="// MISSION_CONTROL"
      >
        // MISSION_CONTROL
      </h1>
      <p class="mt-5 text-base md:text-lg text-[color:var(--on-surface-variant)] max-w-xl">
        {siteConfig.description}
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="stat-tile">
        <div class="stat-tile-label">CPU_LOAD</div>
        <div class="stat-tile-value">12.4%</div>
        <div class="stat-tile-bar">
          <div class="stat-tile-bar-fill" style="width: 12.4%" />
        </div>
      </div>
      <div class="stat-tile">
        <div class="stat-tile-label">MEM_USAGE</div>
        <div class="stat-tile-value">3.8 GB</div>
        <div class="stat-tile-bar">
          <div class="stat-tile-bar-fill" style="width: 45%" />
        </div>
      </div>
      <div class="stat-tile !border-t-blue-400">
        <div class="stat-tile-label">UPLINK</div>
        <div class="stat-tile-value text-blue-600">998.2 MBPS</div>
        <div class="stat-tile-bar">
          <div class="stat-tile-bar-fill bg-blue-500" style="width: 98%" />
        </div>
      </div>
      <div class="stat-tile !border-t-green-400">
        <div class="stat-tile-label">TEMP</div>
        <div class="stat-tile-value text-green-600">31.0°C</div>
        <div class="stat-tile-bar">
          <div class="stat-tile-bar-fill bg-green-500" style="width: 31%" />
        </div>
      </div>
    </div>
  </div>

  <div class="absolute top-0 right-0 p-8 opacity-[0.04] select-none pointer-events-none">
    <span
      class="material-symbols-outlined"
      style="font-size: 200px; font-variation-settings: 'FILL' 1;"
    >
      rocket_launch
    </span>
  </div>
</section>

<script>
  const heading = document.getElementById("hero-title");
  if (heading) {
    const fullText = heading.dataset.fullText || heading.textContent || "";
    heading.textContent = "";
    let i = 0;
    const type = () => {
      if (i < fullText.length) {
        heading.textContent += fullText.charAt(i);
        i++;
        setTimeout(type, 35);
      }
    };
    type();
  }
</script>
