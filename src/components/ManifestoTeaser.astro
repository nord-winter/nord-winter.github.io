---
import { siteConfig } from "../config";
const hasManifesto = siteConfig.manifesto && siteConfig.manifesto.length > 0;
---

{
  hasManifesto && (
    <section id="manifesto" class="py-8">
      <div class="panel-header">
        <span class="material-symbols-outlined text-[color:var(--primary)] text-[20px]">history_edu</span>
        <h2 class="panel-label">Manifesto</h2>
        <span class="panel-tag ml-auto">{siteConfig.manifesto.length} Entries</span>
      </div>

      <div class="module-seam bg-[color:var(--surface-container-lowest)] p-6 md:p-8">
        <div class="max-w-2xl space-y-4">
          {siteConfig.manifesto.map((line, i) => (
            <p class="text-sm md:text-base text-[color:var(--on-surface-variant)] leading-relaxed">
              <span class="font-mono text-xs text-[color:var(--primary)] mr-2">{`0${i + 1}.`}</span>
              {line}
            </p>
          ))}
        </div>
      </div>
    </section>
  )
}
