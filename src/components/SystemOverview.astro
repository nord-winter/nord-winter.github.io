---
import { siteConfig } from "../config";
---

<div class="md:col-span-7 module-seam bg-white p-6 lg:p-8 space-y-6">
  <div class="panel-header">
    <span class="material-symbols-outlined text-[color:var(--primary)] text-[20px]">info</span>
    <h2 class="panel-label">System_Overview</h2>
    <span class="panel-tag ml-auto">#MODULE_A1</span>
  </div>

  <div class="space-y-4">
    <p class="text-[color:var(--on-surface)] leading-relaxed">
      {siteConfig.aboutMe}
    </p>

    <ul class="space-y-3 pt-2">
      {
        siteConfig.aboutHighlights.map((highlight) => (
          <li class="flex items-start gap-4">
            <span class="material-symbols-outlined text-[color:var(--primary)] text-[18px] mt-0.5">
              verified
            </span>
            <div>
              <div class="font-mono text-sm font-semibold text-[color:var(--primary)]">
                {highlight.label}
              </div>
              <p class="text-sm text-[color:var(--on-surface-variant)]">{highlight.text}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="flex flex-wrap gap-2 pt-2">
      {siteConfig.skills.map((skill) => <span class="chip">[ {skill} ]</span>)}
    </div>
  </div>
</div>
