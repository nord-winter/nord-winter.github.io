---
import { siteConfig } from "../config";

const REPO_OWNER = "nord-winter";
const REPO_NAME = "nord-winter.github.io";

type Metric = { label: string; value: string };

let liveMetrics: Metric[] | null = null;

try {
  const userRes = await fetch(`https://api.github.com/users/${REPO_OWNER}`);
  const commitsRes = await fetch(
    `https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/commits?per_page=1`,
  );

  if (userRes.ok) {
    const user = await userRes.json();
    const onGithubSince = new Date(user.created_at).getFullYear();

    let commitCount = 1;
    if (commitsRes.ok) {
      const link = commitsRes.headers.get("link");
      const match = link?.match(/[?&]page=(\d+)>;\s*rel="last"/);
      if (match) commitCount = parseInt(match[1], 10);
    }

    liveMetrics = [
      { label: "On_GitHub_Since", value: `${onGithubSince}` },
      { label: "Commits_This_Repo", value: `${commitCount}` },
    ];
  }
} catch {
  liveMetrics = null;
}

const metrics = liveMetrics ?? siteConfig.metrics;
const isLive = liveMetrics !== null;
---

<div class="module-seam bg-[color:var(--surface-container-lowest)] p-6 lg:p-8">
  <div class="panel-header">
    <span class="material-symbols-outlined text-[color:var(--primary)] text-[20px]">query_stats</span>
    <h2 class="panel-label">Core_Metrics // Repo_Telemetry</h2>
    <span class="panel-tag ml-auto">{isLive ? "Github_Api // Live" : "Static_Fallback"}</span>
  </div>

  <div class={`grid grid-cols-1 gap-4 ${metrics.length === 2 ? "md:grid-cols-2" : "md:grid-cols-3"}`}>
    {
      metrics.map((metric) => (
        <div class="p-6 module-seam brushed-metal hover:brightness-105 transition-all">
          <div class="font-mono text-xs uppercase mb-4 text-[color:var(--primary)] font-bold">
            {metric.label}
          </div>
          <div class="font-mono text-3xl text-[color:var(--primary)] font-bold">
            {metric.value}
          </div>
          <div class="mt-4 h-10 flex items-end gap-1">
            <div class="w-full bg-[color-mix(in_srgb,var(--primary)_20%,transparent)] h-[40%]" />
            <div class="w-full bg-[color-mix(in_srgb,var(--primary)_40%,transparent)] h-[55%]" />
            <div class="w-full bg-[color-mix(in_srgb,var(--primary)_60%,transparent)] h-[70%]" />
            <div class="w-full bg-[color-mix(in_srgb,var(--primary)_80%,transparent)] h-[85%]" />
            <div class="w-full bg-[color:var(--primary)] h-[99%]" />
          </div>
        </div>
      ))
    }
  </div>
</div>
