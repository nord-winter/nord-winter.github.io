---
import { getCollection } from "astro:content";

const postsRaw = await getCollection("posts");
const posts = postsRaw
  .map((p) => ({
    slug: p.id,
    date: p.data.date.toISOString().slice(0, 10),
    title: p.data.title,
    tag: p.data.tag,
    status: p.data.status,
  }))
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 3);

const hasPosts = posts.length > 0;

const statusColor: Record<string, string> = {
  PUBLISHED: "text-[color:var(--primary)]",
  DRAFT: "text-[color:var(--secondary)]",
  PLANNED: "text-[color:var(--secondary)]",
};
---

{
  hasPosts && (
    <section id="log" class="py-8">
      <div class="panel-header">
        <span class="material-symbols-outlined text-[color:var(--primary)] text-[20px]">rss_feed</span>
        <h2 class="panel-label">Dispatch_Log</h2>
        <a
          href="/blog"
          class="panel-tag ml-auto hover:text-[color:var(--primary)] transition-colors inline-flex items-center gap-1"
        >
          View_All_Posts
          <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
        </a>
      </div>

      <div class="module-seam bg-[color:var(--surface-container-lowest)] divide-y divide-[color:var(--outline-variant)]">
        {posts.map((post) => (
          <a href={`/log/${post.slug}`} class="dispatch-row flex items-center gap-4 px-5 py-3 transition-colors">
            <span class="font-mono text-xs text-[color:var(--on-surface-variant)] whitespace-nowrap">
              {post.date}
            </span>
            <span class="text-sm text-[color:var(--on-surface)] flex-1 min-w-0 truncate">{post.title}</span>
            <span class="font-mono text-xs text-[color:var(--secondary)] hidden sm:inline">{post.tag}</span>
            <span class={`font-mono text-xs font-bold flex-shrink-0 ${statusColor[post.status]}`}>
              {post.status}
            </span>
          </a>
        ))}
      </div>
    </section>
  )
}

<style>
  .dispatch-row:hover {
    background: color-mix(in srgb, var(--primary) 5%, transparent);
  }
</style>
